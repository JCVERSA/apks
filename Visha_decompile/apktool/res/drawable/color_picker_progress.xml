    <item android:id="@android:id/background" android:drawable="@drawable/ic_color_progress" />
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <solid android:color="?os_platform_basic_color" />
                <corners android:radius="2.0dp" />
