<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="4.0dp" />
            <solid android:color="#3da1a1a1" />
            <corners android:radius="2.0dp" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <clip>
            <scale android:scaleWidth="100%">
                <shape android:shape="rectangle">
                    <size android:height="4.0dp" />
                    <corners android:radius="2.0dp" />
                    <solid android:color="#ffff4610" />
                </shape>
            </scale>
        </clip>
    </item>
</layer-list>
