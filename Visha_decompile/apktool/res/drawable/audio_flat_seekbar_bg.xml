<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#a62e2e2e" />
            <corners android:radius="19.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <solid android:color="#848484" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2.0dp" android:topLeftRadius="19.0dp" android:topRightRadius="19.0dp" android:bottomLeftRadius="19.0dp" android:bottomRightRadius="19.0dp" />
                <solid android:color="#848484" />
            </shape>
        </clip>
    </item>
</layer-list>
