        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:statusBarColor">?OsBgPrimary</item>
        <item name="android:navigationBarColor">?OsBgPrimary</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:isLightTheme">false</item>
        <item name="colorPrimaryDark">?OsBgPrimary</item>
    </style>
    <style name="XNAppTheme_itel" parent="@style/OS.Theme.Material.itel">
