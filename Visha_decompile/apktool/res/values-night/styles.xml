<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppCustomTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:navigationBarColor">@color/foot_bar_color_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="dark_theme">true</item>
        <item name="foot_bar_background">@color/foot_bar_color_night</item>
        <item name="foot_bar_normal_image_color">@color/online_bottom_operate_bar_image_night</item>
        <item name="min_bar_background">@color/mini_bar_background_color</item>
        <item name="tab_bar_background">@android:color/transparent</item>
    </style>
    <style name="AppTheme" parent="@style/BaseTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.hios" parent="@style/OS.Theme.AppCompat.hios">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.itel" parent="@style/OS.Theme.AppCompat.itel">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.xos" parent="@style/OS.Theme.AppCompat.xos">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="CommonBottomSheetDialog" parent="@style/Theme.Design.BottomSheetDialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
