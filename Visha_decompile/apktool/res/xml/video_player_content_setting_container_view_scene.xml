<?xml version="1.0" encoding="utf-8"?>
<MotionScene
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition motion:constraintSetEnd="@id/end" motion:constraintSetStart="@id/start" motion:duration="500" motion:motionInterpolator="ease" />
    <ConstraintSet android:id="@id/start">
        <Constraint android:id="@id/setting_container_mask" android:layout_width="match_parent" android:layout_height="0.0dp" motion:layout_constraintBottom_toTopOf="@id/setting_container_line" motion:layout_constraintTop_toTopOf="parent" />
        <Constraint android:orientation="horizontal" android:id="@id/setting_container_line" android:layout_width="match_parent" android:layout_height="wrap_content" motion:layout_constraintGuide_percent="0.0" />
        <Constraint android:id="@id/setting_container_view" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0.0dp" motion:layout_constraintBottom_toBottomOf="parent" motion:layout_constraintTop_toBottomOf="@id/setting_container_line">
            <PropertySet android:visibility="gone" motion:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@id/end">
        <Constraint android:id="@id/setting_container_mask" android:layout_width="match_parent" android:layout_height="0.0dp" motion:layout_constraintBottom_toTopOf="@id/setting_container_line" motion:layout_constraintTop_toTopOf="parent" />
        <Constraint android:orientation="horizontal" android:id="@id/setting_container_line" android:layout_width="match_parent" android:layout_height="wrap_content" motion:layout_constraintGuide_percent="0.5" />
        <Constraint android:id="@id/setting_container_view" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0.0dp" motion:layout_constraintBottom_toBottomOf="parent" motion:layout_constraintTop_toBottomOf="@id/setting_container_line">
            <PropertySet android:visibility="gone" motion:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>
</MotionScene>
