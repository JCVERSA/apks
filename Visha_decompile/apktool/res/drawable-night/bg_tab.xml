<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?os_platform_basic_color" />
            <stroke android:width="2.0px" android:color="?os_platform_basic_color" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/os_color_white2" />
            <stroke android:width="0.0px" android:color="@color/os_color_white2" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
</selector>
